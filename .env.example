# ── App ──────────────────────────────────────────────────────────────────
APP_NAME=FollowTheMoney
DEBUG=false
LOG_LEVEL=INFO

# ── PostgreSQL ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ftm:ftm@localhost:5432/follow_the_money

# ── Redis / Celery ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Neo4j ────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ftm_dev_password

# ── External APIs (fill in your keys) ────────────────────────────────────
FEC_API_KEY=
CONGRESS_API_KEY=        # Free key at https://api.congress.gov/sign-up/
OPENSECRETS_API_KEY=
GOOGLE_CIVIC_API_KEY=

# ── Alerting (leave blank to disable) ────────────────────────────────────
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=alerts@followthemoney.local
SMTP_HOST=localhost
SMTP_PORT=587

# ── Congress metadata ─────────────────────────────────────────────────────
CURRENT_CONGRESS=119
CURRENT_SESSION=1

# ── Methodology page URL ──────────────────────────────────────────────────
METHODOLOGY_URL=http://localhost:3000/methodology
